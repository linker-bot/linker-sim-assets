  <!-- Mount pads sit at the shoulder-joint origins of the A7_Lite0812
       combined URDF (joint l2 / joint r2 relative to base_link). Arms
       attach their zero-mass {V}_arm_root here with identity xyz/rpy;
       the arm URDF's first revolute (L1/R1) then sits at xyz=0 and
       recovers the vendor kinematics exactly. -->
  <link name="arm_left_mount" />
  <joint name="weld_arm_left_mount" type="fixed">
    <origin xyz="0 0.13612 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_left_mount" />
  </joint>

  <link name="arm_right_mount" />
  <joint name="weld_arm_right_mount" type="fixed">
    <origin xyz="0 -0.16488 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_right_mount" />
  </joint>
</robot>
