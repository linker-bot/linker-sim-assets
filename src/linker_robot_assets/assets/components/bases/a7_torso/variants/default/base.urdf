<?xml version='1.0' encoding='UTF-8'?>
<!-- A7 data-collection torso (source: 数采方案1.SLDASM base_link). torso_root is
     welded to world by the composer; base_link hangs from it via a fixed joint
     that lifts the shoulder level to ~1.2 m so the arms don't hit the ground.
     Mount pads sit at the source base_link -> joint_l1 / joint_r1 origins; the
     arm's {V}_arm_root attaches there with identity xyz/rpy and its first
     revolute recovers the original kinematics exactly. -->
<robot name="a7_torso">

  <link name="torso_root" />
  <joint name="torso_stand" type="fixed">
    <origin xyz="0 0 1.2" rpy="0 0 0" />
    <parent link="torso_root" />
    <child link="base_link" />
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0080125 0.00020032 -0.58441" rpy="0 0 0" />
      <mass value="10.594" />
      <inertia
        ixx="0.49361" ixy="-1.5105E-06" ixz="0.0010058"
        iyy="0.48657" iyz="1.6802E-05"
        izz="0.19284" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.STL" />
      </geometry>
      <material name="a7_torso_gray">
        <color rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision name="a7_torso_upper_body_01"><geometry><mesh filename="meshes/collision/a7_torso_upper_body_01.stl" /></geometry></collision>
    <collision name="a7_torso_upper_body_02"><geometry><mesh filename="meshes/collision/a7_torso_upper_body_02.stl" /></geometry></collision>
    <collision name="a7_torso_upper_body_03"><geometry><mesh filename="meshes/collision/a7_torso_upper_body_03.stl" /></geometry></collision>
    <collision name="a7_torso_upper_body_04"><geometry><mesh filename="meshes/collision/a7_torso_upper_body_04.stl" /></geometry></collision>
    <collision name="a7_torso_upper_body_05"><geometry><mesh filename="meshes/collision/a7_torso_upper_body_05.stl" /></geometry></collision>
    <collision name="a7_torso_upper_body_06"><geometry><mesh filename="meshes/collision/a7_torso_upper_body_06.stl" /></geometry></collision>
    <collision name="a7_torso_upper_body_07"><origin xyz="0.0205880904104561 0.121702436357737 -0.193239189684391" rpy="0 0 0" /><geometry><box size="0.0502374065108597 0.00513970106840134 0.0118521898984909" /></geometry></collision>
    <collision name="a7_torso_upper_body_08"><origin xyz="0.00681375141721219 -0.0993096455931664 0.0672741234302521" rpy="0 0 0" /><geometry><box size="0.0168008918408304 0.00300748646259308 0.00473126769065857" /></geometry></collision>
    <collision name="a7_torso_column_support_01"><origin xyz="0 0 -0.586999976076186" rpy="0 0 0" /><geometry><box size="0.0900000035762787 0.0599999986588955 1.11399991624057" /></geometry></collision>
    <collision name="a7_torso_column_support_02"><geometry><mesh filename="meshes/collision/a7_torso_column_support_02.stl" /></geometry></collision>
    <collision name="a7_torso_column_support_03"><geometry><mesh filename="meshes/collision/a7_torso_column_support_03.stl" /></geometry></collision>
    <collision name="a7_torso_column_support_04"><geometry><mesh filename="meshes/collision/a7_torso_column_support_04.stl" /></geometry></collision>
