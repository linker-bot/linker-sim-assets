    <collision name="a7_torso_column_support_20"><geometry><mesh filename="meshes/collision/a7_torso_column_support_20.stl" /></geometry></collision>
    <collision name="a7_torso_column_support_21"><geometry><mesh filename="meshes/collision/a7_torso_column_support_21.stl" /></geometry></collision>
    <collision name="a7_torso_column_support_22"><geometry><mesh filename="meshes/collision/a7_torso_column_support_22.stl" /></geometry></collision>
    <collision name="a7_torso_column_support_23"><geometry><mesh filename="meshes/collision/a7_torso_column_support_23.stl" /></geometry></collision>
    <collision name="a7_torso_head_housing_01"><geometry><mesh filename="meshes/collision/a7_torso_head_housing_01.stl" /></geometry></collision>
    <collision name="a7_torso_head_housing_02"><geometry><mesh filename="meshes/collision/a7_torso_head_housing_02.stl" /></geometry></collision>
    <collision name="a7_torso_head_housing_03"><geometry><mesh filename="meshes/collision/a7_torso_head_housing_03.stl" /></geometry></collision>
    <collision name="a7_torso_head_housing_04"><geometry><mesh filename="meshes/collision/a7_torso_head_housing_04.stl" /></geometry></collision>
