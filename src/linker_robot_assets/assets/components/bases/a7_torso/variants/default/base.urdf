    <collision name="a7_torso_caster_rear_left_05"><geometry><mesh filename="meshes/collision/a7_torso_caster_rear_left_05.stl" /></geometry></collision>
    <collision name="a7_torso_caster_rear_left_06"><geometry><mesh filename="meshes/collision/a7_torso_caster_rear_left_06.stl" /></geometry></collision>
    <collision name="a7_torso_caster_rear_left_07"><geometry><mesh filename="meshes/collision/a7_torso_caster_rear_left_07.stl" /></geometry></collision>
    <collision name="a7_torso_caster_front_left_01"><geometry><mesh filename="meshes/collision/a7_torso_caster_front_left_01.stl" /></geometry></collision>
    <collision name="a7_torso_caster_front_left_02"><geometry><mesh filename="meshes/collision/a7_torso_caster_front_left_02.stl" /></geometry></collision>
    <collision name="a7_torso_caster_front_left_03"><geometry><mesh filename="meshes/collision/a7_torso_caster_front_left_03.stl" /></geometry></collision>
    <collision name="a7_torso_caster_front_left_04"><geometry><mesh filename="meshes/collision/a7_torso_caster_front_left_04.stl" /></geometry></collision>
    <collision name="a7_torso_caster_front_left_05"><geometry><mesh filename="meshes/collision/a7_torso_caster_front_left_05.stl" /></geometry></collision>
    <collision name="a7_torso_caster_front_left_06"><geometry><mesh filename="meshes/collision/a7_torso_caster_front_left_06.stl" /></geometry></collision>
    <collision name="a7_torso_caster_front_left_07"><geometry><mesh filename="meshes/collision/a7_torso_caster_front_left_07.stl" /></geometry></collision>
    <collision name="a7_torso_caster_rear_right_01"><geometry><mesh filename="meshes/collision/a7_torso_caster_rear_right_01.stl" /></geometry></collision>
    <collision name="a7_torso_caster_rear_right_02"><geometry><mesh filename="meshes/collision/a7_torso_caster_rear_right_02.stl" /></geometry></collision>
